# Payload
PAYLOAD_SECRET=
PREVIEW_SECRET=

# Neon pooled connection (use *-pooler.*). Direct 5432 URLs often time out.
DATABASE_URL=

# Public site
NEXT_PUBLIC_SITE_URL=https://yhnhealth.com
# Local: http://localhost:3000
# Vercel Production/Preview: the public https origin, never localhost
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional Vercel Blob uploads. Without this, local /media 404s in production.
BLOB_READ_WRITE_TOKEN=
